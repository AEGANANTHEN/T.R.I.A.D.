# ─────────────────────────────────────────────────────────────────────────────
# T.R.I.A.D. — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure secrets for your deployment.
# ─────────────────────────────────────────────────────────────────────────────

# Flask Application Secret Key
SECRET_KEY=cdr-forensic-intel-2024-secret

# DEMS SQLite Database URI (Defaults to sqlite:///dems.db)
# DEMS_DB_URI=sqlite:///dems.db

# DEMS Cryptographic Vault Master Key (32-byte hex or base64 key)
# Recommended for production to decouple vault encryption from Flask secret
# DEMS_VAULT_KEY=

# DEMS PBKDF2 Salt (16-byte hex salt; generated automatically if omitted)
# DEMS_VAULT_SALT=

# ── Phase 7 AI Intelligence: Multi-Tier Inference Configuration ─────────────
# Tier 1: Local Ollama LLM (Default: http://localhost:11434 with llama3.2)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Tier 2: Local OpenAI-Compatible Server (LM Studio, LocalAI, vLLM)
# LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=local-model

# Tier 3: Optional Cloud LLM Keys (Gemini, OpenAI, OpenRouter, Groq, DeepSeek)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# TRIAD_AI_ALLOW_CLOUD=1

# Tier 4: Autonomous High-Fidelity Forensic Reasoning Agent
# Note: If no external LLM is running, TRIAD automatically uses its embedded
# zero-crash deterministic forensic reasoning agent. No API key required.
